# Copy to .env (never committed) and fill in. Docker Compose passes these to the app.

# Outgoing mail for sign-in codes. Fastmail: use an app password limited to SMTP.
TIMELOG_SMTP_HOST=smtp.fastmail.com
TIMELOG_SMTP_PORT=465
TIMELOG_SMTP_USER=you@example.com
TIMELOG_SMTP_PASSWORD=
# An address the SMTP account may send as, e.g. a Fastmail alias.
TIMELOG_MAIL_FROM=timelog@example.com

# Sign in with GitHub: an OAuth app with the callback https://<host>/auth/github/callback
TIMELOG_GITHUB_CLIENT_ID=
TIMELOG_GITHUB_CLIENT_SECRET=
# Where users reach Timelog; used to build the callback URL.
TIMELOG_BASE_URL=https://timelog.example.com
